@startuml GameLogic
state "GameLogic State" as EternalJourney_Game_State_GameLogic_State {
  state "SelectSkillPhase" as EternalJourney_Game_State_GameLogic_State_SelectSkillPhase
  state "BattleInitPhase" as EternalJourney_Game_State_GameLogic_State_BattleInitPhase
  state "BattleRunningPhase" as EternalJourney_Game_State_GameLogic_State_BattleRunningPhase
}

EternalJourney_Game_State_GameLogic_State_BattleInitPhase --> EternalJourney_Game_State_GameLogic_State_BattleRunningPhase : BattleInitialized
EternalJourney_Game_State_GameLogic_State_SelectSkillPhase --> EternalJourney_Game_State_GameLogic_State_BattleInitPhase : SkillSelected

EternalJourney_Game_State_GameLogic_State_BattleInitPhase : OnEnter → InitializeBattle
EternalJourney_Game_State_GameLogic_State_BattleRunningPhase : OnEnter → StartBattle
EternalJourney_Game_State_GameLogic_State_SelectSkillPhase : OnEnter → ShowSelectSkill

[*] --> EternalJourney_Game_State_GameLogic_State_SelectSkillPhase
@enduml