@startuml BattleUIState
state "BattleUIState" as EternalJourney_BattleUI_State_BattleUIState {
  state "Active" as EternalJourney_BattleUI_State_BattleUIState_Active
  state "InActive" as EternalJourney_BattleUI_State_BattleUIState_InActive
}

EternalJourney_BattleUI_State_BattleUIState_Active --> EternalJourney_BattleUI_State_BattleUIState_Active : PhysicsProcess
EternalJourney_BattleUI_State_BattleUIState_Active --> EternalJourney_BattleUI_State_BattleUIState_Active : SPButtonPressed
EternalJourney_BattleUI_State_BattleUIState_InActive --> EternalJourney_BattleUI_State_BattleUIState_Active : BattleStarted

EternalJourney_BattleUI_State_BattleUIState_Active : OnGameOver() → GameOver
EternalJourney_BattleUI_State_BattleUIState_Active : OnPhysicsProcess → TikCount
EternalJourney_BattleUI_State_BattleUIState_Active : OnScoreCountUp() → ScoreChanged
EternalJourney_BattleUI_State_BattleUIState_Active : OnScrapCountUp() → ScrapChanged
EternalJourney_BattleUI_State_BattleUIState_Active : OnShipHpChanged() → ShipHpChanged
EternalJourney_BattleUI_State_BattleUIState_Active : OnSpPercentChanged() → SpPercentChanged
EternalJourney_BattleUI_State_BattleUIState_InActive : OnBattleStarted → ActivateBattleUI
@enduml