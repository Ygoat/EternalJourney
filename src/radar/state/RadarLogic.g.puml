@startuml RadarState
state "RadarState" as EternalJourney_Radar_State_RadarState {
  state "EnemySearched" as EternalJourney_Radar_State_RadarState_EnemySearched
  state "Idle" as EternalJourney_Radar_State_RadarState_Idle
}

EternalJourney_Radar_State_RadarState_EnemySearched --> EternalJourney_Radar_State_RadarState_EnemySearched : PhysicProcess
