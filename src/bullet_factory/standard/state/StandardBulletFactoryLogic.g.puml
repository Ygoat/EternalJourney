@startuml StandardBulletFactoryState
state "StandardBulletFactoryState" as EternalJourney_BulletFactory_Standard_State_StandardBulletFactoryState {
  state "CoolDown" as EternalJourney_BulletFactory_Standard_State_StandardBulletFactoryState_CoolDown
  state "Ready" as EternalJourney_BulletFactory_Standard_State_StandardBulletFactoryState_Ready
}

EternalJourney_BulletFactory_Standard_State_StandardBulletFactoryState_CoolDown --> EternalJourney_BulletFactory_Standard_State_StandardBulletFactoryState_Ready : CoolDownComplete
EternalJourney_BulletFactory_Standard_State_StandardBulletFactoryState_Ready --> EternalJourney_BulletFactory_Standard_State_StandardBulletFactoryState_CoolDown : FireRequested

EternalJourney_BulletFactory_Standard_State_StandardBulletFactoryState_CoolDown : OnEnter → StartCoolDown
EternalJourney_BulletFactory_Standard_State_StandardBulletFactoryState_Ready : OnFireRequested → Fire
@enduml