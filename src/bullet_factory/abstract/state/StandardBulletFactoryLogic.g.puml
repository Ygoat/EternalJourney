@startuml StandardBulletFactoryState
state "StandardBulletFactoryState" as EternalJourney_Bullet_Abstract_State_StandardBulletFactoryState {
  state "CoolDown" as EternalJourney_Bullet_Abstract_State_StandardBulletFactoryState_CoolDown
  state "Ready" as EternalJourney_Bullet_Abstract_State_StandardBulletFactoryState_Ready
}

EternalJourney_Bullet_Abstract_State_StandardBulletFactoryState_CoolDown --> EternalJourney_Bullet_Abstract_State_StandardBulletFactoryState_Ready : CoolDownComplete
EternalJourney_Bullet_Abstract_State_StandardBulletFactoryState_Ready --> EternalJourney_Bullet_Abstract_State_StandardBulletFactoryState_CoolDown : FireRequested

EternalJourney_Bullet_Abstract_State_StandardBulletFactoryState_CoolDown : OnEnter → StartCoolDown
EternalJourney_Bullet_Abstract_State_StandardBulletFactoryState_Ready : OnFireRequested → Fire
@enduml