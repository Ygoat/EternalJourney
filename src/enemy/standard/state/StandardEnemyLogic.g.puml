@startuml StandardEnemyState
state "StandardEnemyState" as EternalJourney_Enemy_Standard_State_StandardEnemyState {
  state "Invading" as EternalJourney_Enemy_Standard_State_StandardEnemyState_Invading
  state "SpawnWait" as EternalJourney_Enemy_Standard_State_StandardEnemyState_SpawnWait
}

EternalJourney_Enemy_Standard_State_StandardEnemyState_Invading --> EternalJourney_Enemy_Standard_State_StandardEnemyState_SpawnWait : OutOfArea
EternalJourney_Enemy_Standard_State_StandardEnemyState_SpawnWait --> EternalJourney_Enemy_Standard_State_StandardEnemyState_Invading : Spawn

EternalJourney_Enemy_Standard_State_StandardEnemyState_Invading : CheckUnderZeroDurability() → Destroyed
EternalJourney_Enemy_Standard_State_StandardEnemyState_Invading : OnBulletHit → CurrentDurChange
EternalJourney_Enemy_Standard_State_StandardEnemyState_Invading : OnOutOfArea → Destroyed
EternalJourney_Enemy_Standard_State_StandardEnemyState_Invading : OnPhysicsProcess → Move
EternalJourney_Enemy_Standard_State_StandardEnemyState_Invading : UpdateColor() → UpdateColor
EternalJourney_Enemy_Standard_State_StandardEnemyState_SpawnWait : OnSpawn → StartInvade
@enduml