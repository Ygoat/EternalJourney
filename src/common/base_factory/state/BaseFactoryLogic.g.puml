@startuml BaseFactoryState
state "BaseFactoryState" as EternalJourney_Common_BaseFactory_State_BaseFactoryState {
  state "CoolDown" as EternalJourney_Common_BaseFactory_State_BaseFactoryState_CoolDown
  state "Generating" as EternalJourney_Common_BaseFactory_State_BaseFactoryState_Generating
  state "Ready" as EternalJourney_Common_BaseFactory_State_BaseFactoryState_Ready
}

EternalJourney_Common_BaseFactory_State_BaseFactoryState_CoolDown --> EternalJourney_Common_BaseFactory_State_BaseFactoryState_Ready : CoolDownComplete
EternalJourney_Common_BaseFactory_State_BaseFactoryState_Generating --> EternalJourney_Common_BaseFactory_State_BaseFactoryState_CoolDown : StartCoolDown
EternalJourney_Common_BaseFactory_State_BaseFactoryState_Ready --> EternalJourney_Common_BaseFactory_State_BaseFactoryState_Generating : Generate

EternalJourney_Common_BaseFactory_State_BaseFactoryState_CoolDown : OnEnter → Cooling
EternalJourney_Common_BaseFactory_State_BaseFactoryState_Generating : OnEnter → Generated
@enduml