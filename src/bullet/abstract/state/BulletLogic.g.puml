@startuml BulletState
state "BulletState" as EternalJourney_Bullet_Abstract_State_BulletState {
  state "Blast" as EternalJourney_Bullet_Abstract_State_BulletState_Blast
  state "EmitWait" as EternalJourney_Bullet_Abstract_State_BulletState_EmitWait
  state "InFlight" as EternalJourney_Bullet_Abstract_State_BulletState_InFlight
}

EternalJourney_Bullet_Abstract_State_BulletState_Blast --> EternalJourney_Bullet_Abstract_State_BulletState_Blast : EnemyHit
EternalJourney_Bullet_Abstract_State_BulletState_Blast --> EternalJourney_Bullet_Abstract_State_BulletState_Blast : TargetHit
EternalJourney_Bullet_Abstract_State_BulletState_Blast --> EternalJourney_Bullet_Abstract_State_BulletState_EmitWait : BlastTimerTimeout
EternalJourney_Bullet_Abstract_State_BulletState_EmitWait --> EternalJourney_Bullet_Abstract_State_BulletState_InFlight : Emit
EternalJourney_Bullet_Abstract_State_BulletState_InFlight --> EternalJourney_Bullet_Abstract_State_BulletState_EmitWait : Miss

EternalJourney_Bullet_Abstract_State_BulletState_Blast : OnBlastTimerTimeout → RemoveSelf
EternalJourney_Bullet_Abstract_State_BulletState_EmitWait : OnEmit → SpdUpdated
EternalJourney_Bullet_Abstract_State_BulletState_InFlight : CheckUnderZeroDurability() → Collapse, RemoveSelf
EternalJourney_Bullet_Abstract_State_BulletState_InFlight : OnEnemyHit → CurrentDurChange
EternalJourney_Bullet_Abstract_State_BulletState_InFlight : OnMiss → RemoveSelf
EternalJourney_Bullet_Abstract_State_BulletState_InFlight : OnPhysicsProcess → Move
EternalJourney_Bullet_Abstract_State_BulletState_InFlight : OnTargetHit → CurrentDurChange
@enduml